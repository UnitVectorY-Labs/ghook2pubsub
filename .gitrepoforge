name: "ghook2pubsub"
default_branch: "main"
config:
  osv: sarif
  description: "Consumes GitHub webhooks and publishes them to a GCP Pub/Sub topic."
  license: "MIT"
  language: "go"
  release: "docker-go"
  release_github: true
  status: "active"
  justfile: false
  codecov:
    enabled: true
  docs:
    enabled: true
